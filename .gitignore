# Rust build artifacts
rust/target/
**/*.rs.bk
Cargo.lock

# C++ build artifacts
cpp/build/
*.obj
*.exe
*.pdb
*.ilk

# SAW / Cryptol generated artifacts (regenerated by run.ps1 / verify_all.ps1)
cpp/saw/verify_targets.bc
cpp/saw/verify_targets.ll
cpp/saw/verify_targets_o1.bc
cpp/saw/verify_targets_o1.ll
cpp/saw/verify_targets_ast.json
cpp/saw/out_*/
cpp/saw/*.log
# Stray compiled artifacts (never commit generated bitcode/IR)
cpp/saw/*.bc
cpp/saw/*.ll

rust/saw/sdep.bc
rust/saw/sdep.ll
rust/saw/sdep_patched.bc
rust/saw/sdep_patched.ll
rust/saw/sdep_stripped.ll
rust/saw/sdep_full.bc
rust/saw/*.log

# Pipeline / verify output dirs (regenerated by verify_all.ps1 / regen-docs.ps1)
/verify_out/
/verify_min_out/
/verify_small_out/
/verify_bugs_out/
/test_verify_out/
/pipeline*.log
/verify_out_log.txt
/verify_*_log.txt

# Catch-all for build/run logs anywhere in the tree
*.log

# Editor / IDE
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Investigation scratch files (root-level temp output)
/_*.txt
/_*.md

# Pipeline orchestration scratch (regen-docs.ps1)
/.pipeline.pid

# DocFX build output
_site/
obj/

# Generated docs + proof artifacts (produced by scripts/regen-docs.ps1).
# CI (regen-and-publish.yml) regenerates and publishes these fresh from
# SDEP_cpp.cry + extra_docs/ on every push — never commit the output.
/docs/
/proof_manifest.json
/implementation_inventory.json
