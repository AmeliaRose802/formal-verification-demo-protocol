// Slightly larger smoke-test spec for the saw-spec-gen → SAW pipeline.
// Three pure functions exercising:
//   * signed int64_t comparisons / arithmetic
//   * void* pointer-value parameters
//   * bool return  (Bit ↔ i1 wrap)
//   * int64_t return (whole-word return path)

module SDEP_small where

// ---------- inWindow: signed timestamp arithmetic ----------
// Matches C++ `bool inWindow(std::int64_t reqTs, std::int64_t now, std::int64_t window)`.
// Uses SIGNED comparisons (<=$) to mirror C++ signed semantics.
inWindow : [64] -> [64] -> [64] -> Bit
inWindow reqTs now window =
  (reqTs <=$ now) && ((now - reqTs) <=$ window)

// At the moment a request arrives (reqTs == now), the request is in-window
// iff the window is non-negative. Captures the boundary case exactly.
property P1_self_in_window_iff_window_nonnegative a w =
  inWindow a a w == (zero <=$ w)

// A non-negative window always admits a zero-duration request (reqTs == now).
property P2_zero_duration_always_in_nonnegative_window a (w : [64]) =
  (w >=$ 0) ==> inWindow a a w == True


// ---------- isNonNull: void* pointer-value ----------
// Matches C++ `bool isNonNull(void* p)`.
isNonNull : [64] -> Bit
isNonNull p = p != 0

// The null pointer (address 0) is reported as null.
property P3_null_pointer_is_not_nonnull = isNonNull 0 == False

// Any non-zero address is reported as non-null.
property P4_nonzero_pointer_is_nonnull  = isNonNull 1 == True


// ---------- pickGreater: signed max ----------
// Matches C++ `std::int64_t pickGreater(std::int64_t a, std::int64_t b)`.
pickGreater : [64] -> [64] -> [64]
pickGreater a b = if a >$ b then a else b

// The result is at least the first input (signed comparison).
property P5_result_is_at_least_first_input a b = (pickGreater a b >=$ a)

// The result is at least the second input (signed comparison).
property P6_result_is_at_least_second_input a b = (pickGreater a b >=$ b)

// The result is exactly one of the two inputs (never a fresh value).
property P7_result_is_one_of_the_inputs a b =
  (pickGreater a b == a) || (pickGreater a b == b)
