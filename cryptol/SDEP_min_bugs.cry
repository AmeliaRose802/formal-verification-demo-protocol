// Minimal Cryptol spec to exercise saw-spec-gen bugs #11 and #12.
module SDEP_min_bugs where

// For bug #12: 3x std::int64_t typed parameters.
inWindow : [64] -> [64] -> [64] -> Bit
inWindow reqTs now window =
  (reqTs <= now) && ((now - reqTs) <= window)

property P_inWindow_lower_bound a w =
  inWindow a a w == True

// For bug #11: void* in C++; model as a 64-bit address on the Cryptol side.
// (The point of this entry is to make saw-spec-gen try to lower void* —
// it doesn't matter whether the equivalence is meaningful, only that
// codegen succeeds.)
isNonNull : [64] -> Bit
isNonNull p = p != 0
