// ─────────────────────────────────────────────────────────────────────
// KeyStore stateful verification harness (implementation-level SAW).
//
// Verifies the four public KeyStore methods directly against the
// production bitcode compiled from cpp/src/key_store.cpp:
//
//   activate(const Uuid&)        -> ActivationResult   (mutating ladder)
//   provision(EnrollmentKey)     -> optional<...>       (TOFU enrolment)
//   hasKey() / isActive()        -> bool                (read accessors)
//
// The scoped_lock is modelled as memory-neutral, always-succeeding
// _Mtx_lock / _Mtx_unlock overrides, and Uuid::operator== lowers to a
// FAITHFUL memcmp override (returns 0 iff the 16 bytes match — never a
// havoc). Object layout (152 bytes): mutex 0..79 · keyId@80 · isActive@128
// · optional engaged flag@144. See SDEP_cpp.cry for the Cryptol models
// (keyStoreActivate*, keyStoreProvision*, ksHasKey, ksIsActive) and the
// KS1-4 / PROV1-5 / ACC1 corollary properties.
// ─────────────────────────────────────────────────────────────────────

enable_experimental;
import "SDEP_cpp.cry";

m <- llvm_load_module "key_store.bc";

// ── System-primitive overrides (faithful, not havoc) ──────────────────
let mtx_lock_spec = do {
    p <- llvm_fresh_pointer (llvm_int 8);
    llvm_execute_func [p];
    llvm_return (llvm_term {{ 0 : [32] }});
};
let mtx_unlock_spec = do {
    p <- llvm_fresh_pointer (llvm_int 8);
    llvm_execute_func [p];
    llvm_return (llvm_term {{ 0 : [32] }});
};
// memcmp over the 16-byte Uuid: faithful equality, so the keyId-match
// branch in `activate` corresponds exactly to Cryptol `ksIdMatch`.
let memcmp16_spec = do {
    pa <- llvm_alloc_readonly (llvm_array 16 (llvm_int 8));
    a  <- llvm_fresh_var "a" (llvm_array 16 (llvm_int 8));
    llvm_points_to pa (llvm_term a);
    pb <- llvm_alloc_readonly (llvm_array 16 (llvm_int 8));
    b  <- llvm_fresh_var "b" (llvm_array 16 (llvm_int 8));
    llvm_points_to pb (llvm_term b);
    llvm_execute_func [pa, pb, llvm_term {{ 16 : [64] }}];
    llvm_return (llvm_term {{ if a == b then (0 : [32]) else 1 }});
};

ov_lock   <- llvm_unsafe_assume_spec m "_Mtx_lock"   mtx_lock_spec;
ov_unlock <- llvm_unsafe_assume_spec m "_Mtx_unlock" mtx_unlock_spec;
ov_memcmp <- llvm_unsafe_assume_spec m "memcmp"      memcmp16_spec;

// Common: a sane, well-formed KeyStore object image.
//   - mutex recursion counter (i32 @76) not at INT_MAX (throw path dead)
//   - engaged (@144) and isActive (@128) are valid booleans (trunc nuw)
let fresh_object = do {
    this_ptr <- llvm_alloc_aligned 8 (llvm_array 152 (llvm_int 8));
    this_pre <- llvm_fresh_var "this_pre" (llvm_array 152 (llvm_int 8));
    llvm_points_to this_ptr (llvm_term this_pre);
    llvm_precond {{ ((this_pre @ 79) # (this_pre @ 78) # (this_pre @ 77) # (this_pre @ 76))
                     != (0x7fffffff : [32]) }};
    llvm_precond {{ (this_pre @ 144) <= 1 }};
    llvm_precond {{ (this_pre @ 128) <= 1 }};
    return (this_ptr, this_pre);
};

// ── activate ──────────────────────────────────────────────────────────
let activate_spec = do {
    (this_ptr, this_pre) <- fresh_object;
    keyId_ptr <- llvm_alloc_readonly (llvm_array 16 (llvm_int 8));
    keyId <- llvm_fresh_var "keyId" (llvm_array 16 (llvm_int 8));
    llvm_points_to keyId_ptr (llvm_term keyId);

    llvm_execute_func [this_ptr, keyId_ptr];

    llvm_points_to this_ptr (llvm_term {{ keyStoreActivatePost this_pre keyId }});
    llvm_return (llvm_term {{ keyStoreActivateRet this_pre keyId }});
};

// ── provision (fresh enrolment) ───────────────────────────────────────
let provision_fresh_spec = do {
    (this_ptr, this_pre) <- fresh_object;
    llvm_precond {{ (this_pre @ 144) == 0 }};
    ret_ptr <- llvm_alloc_aligned 8 (llvm_array 72 (llvm_int 8));
    nk_ptr <- llvm_alloc_aligned 8 (llvm_array 64 (llvm_int 8));
    nk <- llvm_fresh_var "nk" (llvm_array 64 (llvm_int 8));
    llvm_points_to nk_ptr (llvm_term nk);

    llvm_execute_func [this_ptr, ret_ptr, nk_ptr];

    llvm_points_to this_ptr (llvm_term {{ keyStoreProvisionPost this_pre nk }});
    llvm_points_to ret_ptr  (llvm_term {{ keyStoreProvisionRet  this_pre nk }});
};

// ── provision (TOFU lock) ─────────────────────────────────────────────
let provision_engaged_spec = do {
    (this_ptr, this_pre) <- fresh_object;
    llvm_precond {{ (this_pre @ 144) == 1 }};
    ret_ptr <- llvm_alloc_aligned 8 (llvm_array 72 (llvm_int 8));
    nk_ptr <- llvm_alloc_aligned 8 (llvm_array 64 (llvm_int 8));
    nk <- llvm_fresh_var "nk" (llvm_array 64 (llvm_int 8));
    llvm_points_to nk_ptr (llvm_term nk);

    llvm_execute_func [this_ptr, ret_ptr, nk_ptr];

    llvm_points_to this_ptr (llvm_term {{ keyStoreProvisionPost this_pre nk }});
    llvm_points_to (llvm_elem ret_ptr 64) (llvm_term {{ 0 : [8] }});
};

// ── hasKey (read accessor, frame condition) ───────────────────────────
let hasKey_spec = do {
    (this_ptr, this_pre) <- fresh_object;
    llvm_execute_func [this_ptr];
    llvm_points_to this_ptr (llvm_term this_pre);          // unchanged
    llvm_return (llvm_term {{ if ksHasKey this_pre then (1 : [1]) else 0 }});
};

// ── isActive (read accessor, frame condition) ─────────────────────────
let isActive_spec = do {
    (this_ptr, this_pre) <- fresh_object;
    llvm_execute_func [this_ptr];
    llvm_points_to this_ptr (llvm_term this_pre);          // unchanged
    llvm_return (llvm_term {{ if ksIsActive this_pre then (1 : [1]) else 0 }});
};

print "=== KeyStore::activate == keyStoreActivateRet/Post ===";
llvm_verify m "?activate@KeyStore@sdep@@QEAA?AW4ActivationResult@2@AEBUUuid@2@@Z"
    [ov_lock, ov_unlock, ov_memcmp] false activate_spec z3;
print "PROVED activate";

print "=== KeyStore::provision (fresh) == keyStoreProvisionPost/Ret ===";
llvm_verify m "?provision@KeyStore@sdep@@QEAA?AV?$optional@UEnrollmentKey@sdep@@@std@@UEnrollmentKey@2@@Z"
    [ov_lock, ov_unlock] false provision_fresh_spec z3;
print "PROVED provision (fresh enrolment)";

print "=== KeyStore::provision (TOFU lock) == frame + nullopt ===";
llvm_verify m "?provision@KeyStore@sdep@@QEAA?AV?$optional@UEnrollmentKey@sdep@@@std@@UEnrollmentKey@2@@Z"
    [ov_lock, ov_unlock] false provision_engaged_spec z3;
print "PROVED provision (TOFU lock)";

print "=== KeyStore::hasKey == ksHasKey (frame) ===";
llvm_verify m "?hasKey@KeyStore@sdep@@QEBA_NXZ"
    [ov_lock, ov_unlock] false hasKey_spec z3;
print "PROVED hasKey";

print "=== KeyStore::isActive == ksIsActive (frame) ===";
llvm_verify m "?isActive@KeyStore@sdep@@QEBA_NXZ"
    [ov_lock, ov_unlock] false isActive_spec z3;
print "PROVED isActive";

print "ALL KEYSTORE PROOFS SUCCEEDED";
