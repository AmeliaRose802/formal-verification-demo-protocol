// Hand-written SAW equivalence spec for sdep::getStatus.
//
// Why this isn't auto-generated:
// --------------------------------
// `getStatus` returns `EnrollmentStatus { fleetMode, hasKey,
// optional<Uuid> key, isActive }`.  The MSVC x64 ABI lowers this as
// a 20-byte sret buffer:
//
//   offset 0      fleetMode      (1 B bool)
//   offset 1      hasKey         (1 B bool)
//   offset 2..17  optional<Uuid> (16 B payload union)
//   offset 18     optional       (1 B engaged flag)
//   offset 19     isActive       (1 B bool)
//
// When the function constructs `nullopt` (keyIsActive == false), the
// 16-byte payload union is *deliberately left uninitialised*.  This
// matches the C++ standard's contract for `std::optional`: only the
// engaged flag must be set; the storage is undefined.
//
// SAW models that uninitialised storage as the bytes already present
// in the sret buffer at call entry.  The Cryptol model
// `getStatus_cpp` therefore takes a `preBytes : [17][8]` parameter
// representing those pre-call optional bytes; we wire it up by
// reading the result buffer's pre-state with `llvm_fresh_var` +
// `llvm_points_to`.
//
// All the other functions in this proof have deterministic returns,
// so saw-spec-gen handles them; getStatus alone needs this custom
// pre-state plumbing.

// Step 1: Load bitcode
//
// We load the -O1 bitcode here, not the -O0 build used by the other
// targets.  At -O0 with `-fno-inline`, the `std::optional<Uuid>`
// constructors invoked by getStatus stay as separate calls into the
// MSVC STL machinery (`_Optional_construct_base`,
// `_Nontrivial_dummy_type`, etc.), which SAW can't simulate without
// hand-written overrides for each layer.  At -O1 the compiler inlines
// those constructors down to plain `store i8` + `llvm.memcpy.p0.p0.i64`
// instructions on the sret buffer, which SAW handles natively.
//
// The decision function itself is still emitted as a real,
// non-inlined `linkonce_odr` body because verify_targets.cpp takes
// its address through `[[gnu::used]] volatile auto*` — no extern "C"
// wrapper, the mangled C++ symbol is what we verify.
m <- llvm_load_module "verify_targets_o1.bc";

// Step 2: Import Cryptol spec
import "SDEP_cpp.cry";

// Step 3: Equivalence spec — C++ getStatus == Cryptol getStatus_cpp
let getStatus_equiv_spec = do {
    // sret: aggregate return passed via hidden first pointer parameter.
    // The buffer's pre-state is symbolic; we read those bytes so the
    // optional<Uuid> nullopt branch in the Cryptol model can refer
    // to them.
    result_ptr <- llvm_alloc (llvm_array 20 (llvm_int 8));
    result_pre <- llvm_fresh_var "result_pre" (llvm_array 20 (llvm_int 8));
    llvm_points_to result_ptr (llvm_term result_pre);

    fleetEnabled <- llvm_fresh_var "fleetEnabled" (llvm_int 1);
    hasKey       <- llvm_fresh_var "hasKey"       (llvm_int 1);
    keyIsActive  <- llvm_fresh_var "keyIsActive"  (llvm_int 1);

    keyId_ptr <- llvm_alloc_readonly (llvm_array 16 (llvm_int 8));
    keyId     <- llvm_fresh_var "keyId" (llvm_array 16 (llvm_int 8));
    llvm_points_to keyId_ptr (llvm_term keyId);

    llvm_execute_func [
        result_ptr,
        llvm_term fleetEnabled,
        llvm_term hasKey,
        llvm_term keyIsActive,
        keyId_ptr
    ];

    // Extract the 17 bytes of the optional<Uuid> storage from the
    // pre-state.  Layout: [fleetMode, hasKey, <17B optional>, isActive].
    // The Cryptol model only references these 17 bytes (when
    // keyIsActive=false the union payload is the pre-state's 16 B,
    // and the engaged flag is overwritten to 0).
    llvm_points_to result_ptr
        (llvm_term {{
            getStatus_cpp fleetEnabled hasKey keyIsActive keyId
                          (take`{17} (drop`{2} result_pre))
        }});
};

// Step 4: Verify equivalence
print "=== Checking: getStatus == getStatus_cpp (Cryptol) ===";
llvm_verify m "?getStatus@sdep@@YA?AUEnrollmentStatus@1@_N00AEBUUuid@1@@Z"
    []
    false getStatus_equiv_spec z3;

print "=== VERIFIED: getStatus == getStatus_cpp ===";
