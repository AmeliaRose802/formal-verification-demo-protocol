// SDEP — ABI-width Cryptol view of the pure decision logic.
//
// `SDEP.cry` (in the cryptol/ folder) models the protocol at the
// minimum bit-widths necessary to express the spec: enums are
// 2- or 3-bit, booleans are `Bit`.  The actual C++ implementation
// compiles with `enum class : std::uint8_t`, so the LLVM ABI for
// the same functions uses 8-bit (and for booleans, 1-bit) values.
//
// SAW equivalence proofs require the Cryptol function on the right
// of `llvm_return` to have *exactly* the LLVM ABI type.  This file
// re-expresses each pure decision function at those widths.
//
// Convention: booleans are modeled as Cryptol `Bit` (not `[1]`).
// `Bit` is the idiomatic Cryptol type for predicates — `/\`, `\/`,
// `==>`, `if/then/else`, and `==` all work directly without any
// `(x ! 0)` unwrap. saw-spec-gen-generated specs emit `(arg ! 0)`
// for i1 fresh vars, which produces `Bit`, so the shim types here
// line up with the generated equivalence call sites with no
// adapter code on either side.
//
// Each function below is structurally identical to the corresponding
// definition in `SDEP.cry` — same branches, same branch order — so
// every C++ vs Cryptol equivalence proof is *also* implicitly a proof
// that the byte-level model agrees with the bit-level spec.  We make
// that connection explicit at the bottom with a Cryptol `property`
// for each function, provable by `:prove` over all 8-bit inputs.

module SDEP_cpp where

////////////////////////////////////////////////////////////////////////
// Enum byte constants (must match enum-class declaration order in
// cpp/include/sdep/types.hpp).
////////////////////////////////////////////////////////////////////////

// FleetMode
FM_Disabled_b        = 0 : [8]
FM_Enabled_b         = 1 : [8]

// KeyVaultResult
KV_Ok_b              = 0 : [8]
KV_NotFound_b        = 1 : [8]
KV_IoError_b         = 2 : [8]

// AuthResult
AR_Authenticated_b   = 0 : [8]
AR_Unauthenticated_b = 1 : [8]
AR_VaultUnavailable_b = 2 : [8]

// ActivationResult — types.hpp declares Success, AlreadyActive, IoFailure.
// Note: SDEP.cry uses the same ordering, so AC_*_b = AC_*.
AC_Success_b         = 0 : [8]
AC_AlreadyActive_b   = 1 : [8]
AC_IoFailure_b       = 2 : [8]

// ProvisionResult — declared in types.hpp as
//   { Succeeded, Unauthorized, BadRequest, Disabled, InternalError }.
PR_Succeeded_b       = 0 : [8]
PR_Unauthorized_b    = 1 : [8]
PR_BadRequest_b      = 2 : [8]
PR_Disabled_b        = 3 : [8]
PR_InternalError_b   = 4 : [8]

// EnrollmentResult — { Succeeded, Unauthorized, Disabled, InternalError }
ER_Succeeded_b       = 0 : [8]
ER_Unauthorized_b    = 1 : [8]
ER_Disabled_b        = 2 : [8]
ER_InternalError_b   = 3 : [8]

// AccessMode
AM_Off_b             = 0 : [8]
AM_Audit_b           = 1 : [8]
AM_Enforce_b         = 2 : [8]

// AccessDecision
AD_Allow_b           = 0 : [8]
AD_Deny_b            = 1 : [8]
AD_NoRule_b          = 2 : [8]

////////////////////////////////////////////////////////////////////////
// 4.1 provisionKey — LLVM: (i1, i1, i8, i1) -> i8
////////////////////////////////////////////////////////////////////////
//
// C++ body:
//   if (!fleetEnabled)                  return Disabled;
//   if (!validRequest)                  return BadRequest;
//   if (vaultResult != KeyVaultResult::Ok)
//                                       return InternalError;
//   if (keyIsActive)                    return Unauthorized;
//   return Succeeded;
//
// This handles ALL 256 possible i8 values of vaultResult uniformly:
// anything that is not KV_Ok (0) is treated as InternalError, exactly
// matching the C++ `!=` check.  No precondition is needed.
provisionKey : Bit -> Bit -> [8] -> Bit -> [8]
provisionKey fleetEnabled validRequest vaultResult keyIsActive =
  if ~fleetEnabled         then PR_Disabled_b
   | ~validRequest         then PR_BadRequest_b
   | vaultResult != KV_Ok_b
                           then PR_InternalError_b
   | keyIsActive           then PR_Unauthorized_b
  else                          PR_Succeeded_b

////////////////////////////////////////////////////////////////////////
// 4.2 enrollDevice — LLVM: (i1, i1, i8, i8) -> i8
////////////////////////////////////////////////////////////////////////
//
// The C++ body uses `switch` on AuthResult and ActivationResult.  Any
// enum value outside the declared set falls through to the defensive
// `return Unauthorized` after the outer switch.  We mirror that here.
enrollDevice : Bit -> Bit -> [8] -> [8] -> [8]
enrollDevice fleetEnabled validMetadata authResult activationResult =
  if ~fleetEnabled         then ER_Disabled_b
   | ~validMetadata        then ER_Unauthorized_b
   | authResult == AR_Authenticated_b   then
        (if activationResult == AC_Success_b       then ER_Succeeded_b
          | activationResult == AC_AlreadyActive_b then ER_Unauthorized_b
          | activationResult == AC_IoFailure_b     then ER_InternalError_b
         else                                           ER_InternalError_b)
   | authResult == AR_VaultUnavailable_b then ER_InternalError_b
   | authResult == AR_Unauthenticated_b  then ER_Unauthorized_b
  else                                         ER_Unauthorized_b

////////////////////////////////////////////////////////////////////////
// 4.3 authenticate — LLVM: (i1, i1, i1) -> i1
////////////////////////////////////////////////////////////////////////
authenticate : Bit -> Bit -> Bit -> Bit
authenticate dateValid signatureValid claimsValid =
  dateValid /\ signatureValid /\ claimsValid

////////////////////////////////////////////////////////////////////////
// 4.3.1 isValidRequestDate — LLVM: (i64, i64, i64) -> i1
////////////////////////////////////////////////////////////////////////
//
// `std::int64_t` semantics. The implementation in cpp/include/sdep/auth.hpp
// first rejects negative timestamps / window (otherwise the subtraction
// `currentTime - requestTs` can wrap signed-overflow when requestTs is near
// INT64_MIN — found by SAW on 2026-05-30, see FINDINGS.md §1). The shim
// below mirrors that guard exactly so the SAW equivalence proof goes
// through for all i64 inputs.
isValidRequestDate : [64] -> [64] -> [64] -> Bit
isValidRequestDate requestTs currentTime windowSeconds =
  if (requestTs <$ 0) \/ (currentTime <$ 0) \/ (windowSeconds <$ 0)
    then False
    else (requestTs <=$ currentTime)
      /\ ((currentTime - requestTs) <=$ windowSeconds)

////////////////////////////////////////////////////////////////////////
// 4.5 enforceAccess — LLVM: (i8, i8) -> i16
////////////////////////////////////////////////////////////////////////
//
// The return type is the 2-byte aggregate { i8 allowed, i8 logged }
// packed into a single i16 by the MSVC ABI.  In little-endian byte
// order the low byte is `allowed` and the high byte is `logged`:
//
//   i16_return = (logged << 8) | allowed
//
// We construct the i16 directly from the two boolean lanes.
private
  packOutcome : Bit -> Bit -> [16]
  packOutcome allowed logged =
    (if logged  then 1 else 0 : [8]) #
    (if allowed then 1 else 0 : [8])
    // little-endian pack: low byte = allowed, high byte = logged

enforceAccess : [8] -> [8] -> [16]
enforceAccess mode decision =
  if mode == AM_Off_b then packOutcome True False
   | mode == AM_Audit_b then
        (if decision == AD_Deny_b then packOutcome True True
         else                          packOutcome True False)
   | mode == AM_Enforce_b then
        (if decision == AD_Allow_b  then packOutcome True  False
          | decision == AD_Deny_b   then packOutcome False True
          | decision == AD_NoRule_b then packOutcome True  False
         else                            packOutcome True  False)
  else                                   packOutcome True  False

////////////////////////////////////////////////////////////////////////
// 4.6 getStatus — LLVM: sret(20 byte EnrollmentStatus), (i1,i1,i1,ptr Uuid)
////////////////////////////////////////////////////////////////////////
//
// EnrollmentStatus IR layout (alignment 1, 20 bytes):
//   byte  0     : fleetMode    (i8)
//   byte  1     : hasKey       (i8, from bool)
//   bytes 2-18  : optional<Uuid> = { union.anon = Uuid (16 B), i8 engaged }
//                  ↳ bytes 2..17 : Uuid bytes when engaged, *otherwise
//                                  uninitialised* (we model as `keyId` from
//                                  the input buffer; see below)
//                  ↳ byte  18    : engaged flag (i8 from bool)
//   byte 19     : isActive     (i8, from bool)
//
// The C++ body is
//   return EnrollmentStatus{
//     .fleetMode = fleetEnabled ? Enabled : Disabled,
//     .hasKey    = hasKey,
//     .keyId     = keyIsActive ? optional<Uuid>{keyId} : nullopt,
//     .isActive  = keyIsActive,
//   };
//
// When `keyIsActive` is false the optional storage is *not* zeroed:
// constructing `nullopt` only sets the engaged flag to 0 and leaves the
// union payload uninitialised.  SAW models that as the bytes already
// present in the sret buffer — which we havoc with a `pre_bytes`
// symbolic in the spec.  The Cryptol model below therefore takes a
// `preBytes : [17][8]` parameter representing the 17 bytes of the
// optional storage prior to the call.  When the key is active we
// overwrite the 16 Uuid bytes; when it's not we leave them alone.
//
// The output is a 20-byte symbolic representing the full IR struct
// after `getStatus` returns.

getStatus :
    Bit ->          // fleetEnabled
    Bit ->          // hasKey
    Bit ->          // keyIsActive
    [16][8] ->      // input Uuid bytes (16 B)
    [17][8] ->      // pre-call bytes of the optional storage (havoc)
    [20][8]
getStatus fleetEnabled hasKey keyIsActive keyId preBytes =
    [fleetModeByte, hasKeyByte] # optionalBytes # [isActiveByte]
  where
    fleetModeByte = if fleetEnabled then FM_Enabled_b else FM_Disabled_b
    hasKeyByte    = if hasKey       then 1            else 0
    isActiveByte  = if keyIsActive  then 1            else 0
    engagedByte   = if keyIsActive  then 1            else 0
    payloadBytes  = if keyIsActive
                     then keyId
                     // nullopt: payload union left at pre-call contents
                     else take`{16} preBytes
    optionalBytes = payloadBytes # [engagedByte]

////////////////////////////////////////////////////////////////////////
// 4.7 canonicalize_lp — LLVM: (ptr out, ptr m, i8 nm, ptr b, i8 nb) -> i64
////////////////////////////////////////////////////////////////////////
//
// Length-prefixed canonicalization writes
//
//     out[0]            = nm
//     out[1..1+nm)      = m[0..nm)
//     out[1+nm]         = nb
//     out[2+nm..2+nm+nb) = b[0..nb)
//
// to `out`, leaving bytes at positions >= 2+nm+nb unchanged. The SAW spec
// (auto-generated under cpp/saw/out_canonicalize_lp/ via saw-spec-gen
// gen-verify with --max-len-precond nm=4 / nb=4) runs at MAX_LEN = 4 —
// the smallest bound that still exercises the loop induction. It composes
// with P24 (FieldLen = 16) up to min(4, 16) = 4: SAW proves the C++
// implements the byte layout for nm,nb <= 4, and P24 proves that byte
// layout is injective at any FieldLen >= 4. Wall-clock SMT timings on
// commodity hardware (Z3 4.x): MAX_LEN=4 ~ seconds (current),
// MAX_LEN=8 ~ 10s, MAX_LEN=12 ~ 2 min, MAX_LEN=16 ~ 13 min. To lift the
// bound entirely use `llvm_invariant`.
//
// To change MAX_LEN: change the [N][8] / [2*N+2][8] sizes below, the
// modulo constants in `byteAt`, and the matching literals in the SAW spec.
//
// Both Cryptol fns take the C arg list verbatim — (out, m, nm, b, nb) —
// so saw-spec-gen's default 1:1 mapping works with no --cryptol-arg-order
// override.  `canonicalize_lp_ret` ignores the buffer args (its result
// depends only on the two lengths); `canonicalize_lp_post` interprets
// the incoming `out` as the *pre-state* of the buffer (i.e. the bytes
// past 2+nm+nb that the C function must leave untouched).

canonicalize_lp_post :
    [10][8] ->      // out (pre-state of the output buffer, 2 + 2*MAX_LEN bytes)
    [4][8] ->       // m   (input buffer, contents only read at indices [0,nm))
    [8] ->          // nm  (length of m, <=MAX_LEN)
    [4][8] ->       // b   (input buffer, contents only read at indices [0,nb))
    [8] ->          // nb  (length of b, <=MAX_LEN)
    [10][8]
canonicalize_lp_post out m nm b nb =
    [ byteAt i | i <- ([0 .. 9] : [10][8]) ]
  where
    byteAt : [8] -> [8]
    byteAt i =
      if  i == 0                            then nm
       | (i >= 1)      /\ (i <= nm)          then m @ ((i - 1) % 4)
       |  i == nm + 1                        then nb
       | (i >= nm + 2) /\ (i < nm + nb + 2)  then b @ ((i - nm - 2) % 4)
      else                                        out @ i

// Return value of canonicalize_lp: total bytes written = 2 + nm + nb.
// Takes the full C arg list and ignores the buffers so the tool can do
// a verbatim 1:1 arg mapping (no --cryptol-arg-order flag needed).
canonicalize_lp_ret : [10][8] -> [4][8] -> [8] -> [4][8] -> [8] -> [64]
canonicalize_lp_ret _ _ nm _ nb = (zext nm) + (zext nb) + 2

////////////////////////////////////////////////////////////////////////
// Well-formedness predicates over ABI-width enum reps
////////////////////////////////////////////////////////////////////////
// C++ enums are `enum class : std::uint8_t` so the LLVM ABI parameter
// is i8.  Symbolic execution explores all 256 values; valid program
// states only ever produce values in the declared range.  These
// predicates assert that range for use as preconditions in properties.

isKeyVaultResult_b   : [8] -> Bit
isKeyVaultResult_b r = r <= KV_IoError_b

isAuthResult_b       : [8] -> Bit
isAuthResult_b r = r <= AR_VaultUnavailable_b

isActivationResult_b : [8] -> Bit
isActivationResult_b r = r <= AC_IoFailure_b

isAccessMode_b       : [8] -> Bit
isAccessMode_b m = m <= AM_Enforce_b

isAccessDecision_b   : [8] -> Bit
isAccessDecision_b d = d <= AD_NoRule_b

////////////////////////////////////////////////////////////////////////
// enforceAccess result extractors
////////////////////////////////////////////////////////////////////////
// enforceAccess packs the EnforceOutcome struct into one i16 with
// little-endian byte order: low byte = allowed (0 or 1), high byte =
// logged (0 or 1). These helpers project the i16 back to Bits.

allowedOf : [16] -> Bit
allowedOf r = (r && 0x0001) != 0

loggedOf  : [16] -> Bit
loggedOf  r = (r && 0x0100) != 0

////////////////////////////////////////////////////////////////////////
// getStatus result extractors
////////////////////////////////////////////////////////////////////////
// EnrollmentStatus byte layout (see getStatus above):
//   byte  0     : fleetMode
//   byte  1     : hasKey
//   bytes 2..17 : optional<Uuid> payload (16 bytes)
//   byte  18    : engaged flag for the optional<Uuid>
//   byte  19    : isActive

statusEngagedByte  : [20][8] -> [8]
statusEngagedByte  s = s @ 18

statusPayloadBytes : [20][8] -> [16][8]
statusPayloadBytes s = take`{16} (drop`{2} s)

////////////////////////////////////////////////////////////////////////
// 4.8 Abstract HMAC primitives (for P8, P9)
////////////////////////////////////////////////////////////////////////

// 256-bit HMAC-SHA256 signing key shared between client and verifier.
type HmacKey = [256]

// 256-bit HMAC-SHA256 authentication tag produced by `hmacSha256`.
type HmacTag = [256]

// Abstract 256-bit handle for a canonicalized request payload. The HMAC
// properties only ever compare `Request` values for equality, so its
// internal structure is irrelevant at this layer.
type Request = [256]

private

  // Specs only use equality of HMAC outputs; the placeholder body is
  // opaque to the solver, which models `hmacSha256` as an uninterpreted
  // pure function for proof purposes.
  // @coverage trusted: deliberate override — the real HMAC-SHA256 in cpp/src is an assumed contract, not proven equal to this algebraic placeholder.
  hmacSha256 : HmacKey -> Request -> HmacTag
  hmacSha256 k r = k ^ r ^ (r <<< 1)   // placeholder; only equality matters

  // Signature check is a thin equality over the assumed HMAC; the C++ side
  // delegates to a real verifier that is trusted, not proven, at this layer.
  // @coverage trusted: deliberate override — signature verification is an assumed contract over the real HMAC.
  isValidSignature : HmacKey -> Request -> HmacTag -> Bit
  isValidSignature key req providedSig = hmacSha256 key req == providedSig

////////////////////////////////////////////////////////////////////////
// 4.9 Length-prefixed canonicalization (for P23, P24, P25)
////////////////////////////////////////////////////////////////////////

// Field length in bytes for the length-prefixed canonicalizer
// (bounded-model parameter; production uses `std::size_t` fields).
type FieldLen = 16

// Index/length width in bits. One byte holds any length up to FieldLen = 16,
// matching the 8-bit tag used by the bounded canonicalizer.
type IndexWidth = 8

private

  canonNormalized : [IndexWidth] -> [FieldLen][8] -> Bit
  canonNormalized n b =
      and [ (i >= n) ==> ((b @ i) == 0)
          | i <- ([0 .. FieldLen - 1] : [FieldLen][IndexWidth]) ]

  // Bounded model writes a one-byte length tag followed by the FieldLen-byte
  // field buffer. Production uses a 64-bit big-endian tag, but the
  // injectivity argument that P23-P25 rely on is identical at any width.
  canonLenPrefixed : [IndexWidth] -> [FieldLen][8] -> [IndexWidth] -> [FieldLen][8] -> [2 * FieldLen + 2][8]
  canonLenPrefixed nm m nb b = [nm] # m # [nb] # b

////////////////////////////////////////////////////////////////////////
// 4.10 Structured Request model (for P28, P29)
////////////////////////////////////////////////////////////////////////

// Per-field byte bound for the structured bounded-model checking layer.
type StructFieldLen = 2

// Maximum number of headers carried by a structured request in the
// bounded model. Two is enough to exhibit every interesting
// boundary-shifting bug between the header list and adjacent fields.
type MaxHeaders  = 2

// A length-prefixed byte buffer: an explicit length `len` plus a
// fixed-size storage array `buf`. For `fieldNormalized` requests the
// trailing bytes of `buf` past `len` are required to be zero.
type Field  = { len : [IndexWidth], buf : [StructFieldLen][8] }

// An HTTP-style header attached to a structured request: name, value,
// and an `isAuth` flag. The flag marks the Authorization header so the
// canonicalizer can exclude its value from the signed payload.
type Header = { name : Field, value : Field, isAuth : Bit }

// Structural request shape used by the canonicalizer model: HTTP
// method, path, body, the request-bound timestamp, and a fixed-size
// vector of headers. This is the layer the P28+ properties reason
// about, in contrast with the opaque `Request = [256]` used by the
// abstract HMAC properties.
type StructuredRequest =
  { method    : Field
  , path      : Field
  , body      : Field
  , timestamp : [64]
  , hdrs      : [MaxHeaders]Header
  }

private

  fieldNormalized : Field -> Bit
  fieldNormalized f =
    (f.len <= (`StructFieldLen : [IndexWidth])) /\
    and [ (i >= f.len) ==> ((f.buf @ i) == 0)
        | i <- ([0 .. StructFieldLen - 1] : [StructFieldLen][IndexWidth]) ]

  requestNormalized : StructuredRequest -> Bit
  requestNormalized r =
    fieldNormalized r.method /\
    fieldNormalized r.path /\
    fieldNormalized r.body /\
    and [ fieldNormalized h.name /\ fieldNormalized h.value
        | h <- r.hdrs ]

  lpField : Field -> [1 + StructFieldLen][8]
  lpField f = [f.len] # f.buf

  lpHeader : Header -> [2 * (1 + StructFieldLen)][8]
  lpHeader h = if h.isAuth then zero
                           else (lpField h.name) # (lpField h.value)

canonicalizeS : StructuredRequest -> [3 * (1 + StructFieldLen) + MaxHeaders * 2 * (1 + StructFieldLen) + 8][8]
canonicalizeS r =
    lpField r.method
  # lpField r.body
  # join [ lpHeader h | h <- r.hdrs ]
  # lpField r.path
  # (split r.timestamp : [8][8])

private

  verifierTimestamp_current : StructuredRequest -> [64] -> [64]
  verifierTimestamp_current r _ = r.timestamp

////////////////////////////////////////////////////////////////////////
// 5. Security properties (P1–P29), proven directly on the C++ ABI
//    spec above.  SAW proves each function in this module equals the
//    corresponding C++ implementation, so any property proven here
//    transfers to the C++ code by Cryptol equality.
////////////////////////////////////////////////////////////////////////

// ---- Category A: Key Lifecycle Safety -------------------------------------

// P1: An active key cannot be re-activated. Once the activation oracle
// reports the key is already active, enrollDevice can never return Succeeded
// no matter what other inputs the request carries.
property P1_ActiveKeyCannotBeReactivated fleetEnabled validMetadata authResult keyAlreadyActive =
  isAuthResult_b authResult ==>
    keyAlreadyActive ==>
      enrollDevice fleetEnabled validMetadata authResult AC_AlreadyActive_b
        != ER_Succeeded_b

// P2: An active key blocks further provisioning. Even with a valid request
// and a healthy vault, attempting to provision while the key is already
// active returns Unauthorized.
property P2_ActiveKeyBlocksProvisioning fleetEnabled validRequest vaultResult =
  isKeyVaultResult_b vaultResult ==>
    fleetEnabled ==>
      validRequest ==>
        vaultResult == KV_Ok_b ==>
          provisionKey fleetEnabled validRequest vaultResult True
            == PR_Unauthorized_b

// P3: Key ID is hidden before activation.
property P3_KeyIdHiddenBeforeActivation fleetEnabled hasKey keyId preBytes =
  statusEngagedByte (getStatus fleetEnabled hasKey False keyId preBytes) == 0

// P4: Key ID is revealed after activation.
property P4_KeyIdRevealedAfterActivation fleetEnabled hasKey keyId preBytes =
  (statusEngagedByte  (getStatus fleetEnabled hasKey True keyId preBytes) == 1) /\
  (statusPayloadBytes (getStatus fleetEnabled hasKey True keyId preBytes) == keyId)

// P5: A disabled fleet rejects every request — both provisionKey and
// enrollDevice short-circuit to their respective Disabled results.
property P5_DisabledFleetRejectsEverything validRequest vaultResult validMetadata
                                            authResult activationResult keyIsActive =
  isKeyVaultResult_b vaultResult ==>
    isAuthResult_b authResult ==>
      isActivationResult_b activationResult ==>
        (provisionKey False validRequest vaultResult keyIsActive == PR_Disabled_b)
        /\ (enrollDevice False validMetadata authResult activationResult
              == ER_Disabled_b)

// ---- Category B: Authentication Security ----------------------------------

// P6: Authentication rejects any request with an invalid date.
property P6_AuthRejectsInvalidDate sigValid claimsValid =
  authenticate False sigValid claimsValid == False

// P7: Authentication rejects any request with an invalid signature.
property P7_AuthRejectsInvalidSignature dateValid claimsValid =
  authenticate dateValid False claimsValid == False

// P8: A correct HMAC always verifies.
property P8_CorrectHmacVerifies (k : HmacKey) (r : Request) =
  isValidSignature k r (hmacSha256 k r) == True

// P9: A wrong HMAC always fails to verify.
property P9_WrongHmacFails (k : HmacKey) (r : Request) (sig : HmacTag) =
  (sig != hmacSha256 k r) ==> (isValidSignature k r sig == False)

// P10: An enrollment with missing metadata returns Unauthorized when the
// fleet is enabled.
property P10_MissingMetadataIsUnauthorized fleetEnabled authResult activationResult =
  fleetEnabled ==>
    isAuthResult_b authResult ==>
      isActivationResult_b activationResult ==>
        enrollDevice fleetEnabled False authResult activationResult
          == ER_Unauthorized_b

// ---- Category C: Access Control -------------------------------------------

// P11: Access-off mode allows every decision and logs nothing.
property P11_AccessOffAllowsWithoutLogging decision =
  isAccessDecision_b decision ==>
    (allowedOf (enforceAccess AM_Off_b decision) == True) /\
    (loggedOf  (enforceAccess AM_Off_b decision) == False)

// P12: Access-audit mode never denies.
property P12_AccessAuditNeverDenies decision =
  isAccessDecision_b decision ==>
    allowedOf (enforceAccess AM_Audit_b decision) == True

// P13: Access-enforce mode blocks any explicitly denied request.
property P13_AccessEnforceBlocksDenials =
  (allowedOf (enforceAccess AM_Enforce_b AD_Deny_b) == False) /\
  (loggedOf  (enforceAccess AM_Enforce_b AD_Deny_b) == True)

// P14: Access-enforce mode allows any explicitly permitted request.
property P14_AccessEnforceAllowsPermitted =
  (allowedOf (enforceAccess AM_Enforce_b AD_Allow_b) == True) /\
  (loggedOf  (enforceAccess AM_Enforce_b AD_Allow_b) == False)

// ---- Category D: Protocol Liveness ----------------------------------------

// P15: A valid, authorized provisioning request on an inactive key succeeds.
property P15_AuthorizedRequestOnInactiveKeySucceeds =
  provisionKey True True KV_Ok_b False == PR_Succeeded_b

// P16: An authenticated enrollment with a successful activation succeeds.
property P16_AuthenticatedEnrollmentSucceeds =
  enrollDevice True True AR_Authenticated_b AC_Success_b == ER_Succeeded_b

// P17: A timestamp exactly at the window boundary is accepted.
// C++ uses std::int64_t with SIGNED comparison; preconditions guard
// against signed overflow on the (requestTs + window) calculation.
property P17_TimestampAtBoundaryAccepted (requestTs : [64]) (window : [64]) =
  (window    >=$ 0) ==>
  (requestTs >=$ 0) ==>
  (requestTs <=$ (0x7FFFFFFFFFFFFFFF - window)) ==>
    isValidRequestDate requestTs (requestTs + window) window == True

// P18: A timestamp beyond the window boundary is rejected.
property P18_TimestampBeyondBoundaryRejected
    (requestTs : [64]) (currentTime : [64]) (window : [64]) =
  (window >=$ 0) ==>
    (requestTs <=$ currentTime) ==>
      ((currentTime - requestTs) >$ window) ==>
        isValidRequestDate requestTs currentTime window == False

// ---- Category E: Error Handling -------------------------------------------

// P19: A vault-unavailable result maps to InternalError.
property P19_VaultUnavailableIsInternalError activationResult =
  isActivationResult_b activationResult ==>
    enrollDevice True True AR_VaultUnavailable_b activationResult
      == ER_InternalError_b

// P20: An invalid request maps to BadRequest, not Unauthorized.
property P20_InvalidRequestIsBadRequest vaultResult keyIsActive =
  isKeyVaultResult_b vaultResult ==>
    provisionKey True False vaultResult keyIsActive == PR_BadRequest_b

// P21: Activate without metadata maps to Unauthorized.
property P21_ActivateWithoutMetadataIsUnauthorized authResult activationResult =
  isAuthResult_b authResult ==>
    isActivationResult_b activationResult ==>
      enrollDevice True False authResult activationResult == ER_Unauthorized_b

// P22: An activation I/O failure maps to InternalError.
property P22_ActivationIoFailureIsInternalError activationResult =
  isActivationResult_b activationResult ==>
    (activationResult != AC_Success_b) ==>
      (activationResult != AC_AlreadyActive_b) ==>
        enrollDevice True True AR_Authenticated_b activationResult
          == ER_InternalError_b

// ---- Category F: Canonicalization byte-injectivity ------------------------

// P23: Distinct normalized requests have distinct canonical byte streams.
property P23_DistinctRequestsHaveDistinctCanonicalBytes
    nm1 m1 nb1 b1 nm2 m2 nb2 b2 =
  ( (nm1 <= (`FieldLen : [IndexWidth])) /\ (nb1 <= (`FieldLen : [IndexWidth])) /\
    (nm2 <= (`FieldLen : [IndexWidth])) /\ (nb2 <= (`FieldLen : [IndexWidth])) /\
    canonNormalized nm1 m1 /\ canonNormalized nb1 b1 /\
    canonNormalized nm2 m2 /\ canonNormalized nb2 b2 /\
    canonLenPrefixed nm1 m1 nb1 b1 == canonLenPrefixed nm2 m2 nb2 b2 )
    ==> ((nm1, m1, nb1, b1) == (nm2, m2, nb2, b2))

// P24: Distinct normalized header lists have distinct canonical byte streams.
property P24_DistinctHeadersHaveDistinctCanonicalBytes
    nm1 m1 nb1 b1 nm2 m2 nb2 b2 =
  ( (nm1 <= (`FieldLen : [IndexWidth])) /\ (nb1 <= (`FieldLen : [IndexWidth])) /\
    (nm2 <= (`FieldLen : [IndexWidth])) /\ (nb2 <= (`FieldLen : [IndexWidth])) /\
    canonNormalized nm1 m1 /\ canonNormalized nb1 b1 /\
    canonNormalized nm2 m2 /\ canonNormalized nb2 b2 /\
    canonLenPrefixed nm1 m1 nb1 b1 == canonLenPrefixed nm2 m2 nb2 b2 )
    ==> ((nm1, m1, nb1, b1) == (nm2, m2, nb2, b2))

// P25: Distinct normalized query lists have distinct canonical byte streams.
property P25_DistinctQueriesHaveDistinctCanonicalBytes
    nm1 m1 nb1 b1 nm2 m2 nb2 b2 =
  ( (nm1 <= (`FieldLen : [IndexWidth])) /\ (nb1 <= (`FieldLen : [IndexWidth])) /\
    (nm2 <= (`FieldLen : [IndexWidth])) /\ (nb2 <= (`FieldLen : [IndexWidth])) /\
    canonNormalized nm1 m1 /\ canonNormalized nb1 b1 /\
    canonNormalized nm2 m2 /\ canonNormalized nb2 b2 /\
    canonLenPrefixed nm1 m1 nb1 b1 == canonLenPrefixed nm2 m2 nb2 b2 )
    ==> ((nm1, m1, nb1, b1) == (nm2, m2, nb2, b2))

// ---- Category G: enforceAccess matrix-coverage closures -------------------

// P26: Access-enforce mode with no matching rule allows silently.
property P26_EnforceWithoutRuleAllowsSilently =
  (allowedOf (enforceAccess AM_Enforce_b AD_NoRule_b) == True) /\
  (loggedOf  (enforceAccess AM_Enforce_b AD_NoRule_b) == False)

// P27: Access-audit mode logs IFF the underlying decision is Deny.
property P27_AuditLogsOnlyOnDenial decision =
  isAccessDecision_b decision ==>
    loggedOf (enforceAccess AM_Audit_b decision) == (decision == AD_Deny_b)

// ---- Category H: Structured-request properties ----------------------------

// P28: Auth-header value excluded from canonicalization.
property P28_AuthHeaderValueExcludedFromCanonicalization r v1 v2 =
  ( requestNormalized r /\ fieldNormalized v1 /\ fieldNormalized v2 ) ==>
    canonicalizeS { r | hdrs = [ if h.isAuth then { h | value = v1 } else h
                                | h <- r.hdrs ] }
    ==
    canonicalizeS { r | hdrs = [ if h.isAuth then { h | value = v2 } else h
                                | h <- r.hdrs ] }

// P29: The verifier uses the request-bound timestamp, not the caller's.
property P29_VerifierUsesRequestBoundTimestamp r tsFromCaller =
  verifierTimestamp_current r tsFromCaller == r.timestamp

// ---- Category I: Intentional counterexamples ------------------------------
//
// The properties in this category are *deliberately wrong*.  They encode
// tempting-but-false intuitions about the protocol so the rendered docs
// can show real examples of both "proven" (✓) and "refuted" (✗) verdicts
// side by side.  The Cryptol prover will find a counterexample for each
// of these; the proof manifest records them as `failed` on purpose, and
// `prove_all.ps1` tolerates them when launched with `-AllowFailures`.

// P30: "Audit and Enforce modes are interchangeable — both return the
// same allow flag for any well-formed access decision."
//
// EXPECTED VERDICT: FAILS.
// Counterexample: decision = AD_Deny_b.  Audit mode still allows the
// request (only logging the denial), whereas Enforce mode actually
// blocks it.  This is the whole point of having two modes.
property P30_AuditEqualsEnforce decision =
  isAccessDecision_b decision ==>
    allowedOf (enforceAccess AM_Audit_b   decision) ==
    allowedOf (enforceAccess AM_Enforce_b decision)

// P31: "Authentication succeeds as long as the signature is valid —
// stale dates and missing claims don't really matter in practice."
//
// EXPECTED VERDICT: FAILS.
// Counterexample: dateValid = False, signatureValid = True,
// claimsValid = True.  The real authenticate requires *all three*
// (`dateValid /\ signatureValid /\ claimsValid`), so a stale request
// is still rejected even with a perfect signature.  This property
// exists to make the AND-of-three structure visible to readers.
property P31_SignatureAloneAuthenticates dateValid signatureValid claimsValid =
  signatureValid ==> authenticate dateValid signatureValid claimsValid

// P32: "If enrollment authentication succeeds, the device gets enrolled."
//
// EXPECTED VERDICT: FAILS.
// Counterexample: authResult = AR_Authenticated_b,
// activationResult = AC_IoFailure_b.  Authentication passes but the
// hardware activation step fails, so enrollDevice returns
// ER_InternalError_b instead of ER_Succeeded_b.  A correct claim
// would also have to constrain activationResult.
property P32_AuthenticatedImpliesEnrolled fleetEnabled validMetadata activationResult =
  ( fleetEnabled /\ validMetadata ) ==>
    enrollDevice fleetEnabled validMetadata
                     AR_Authenticated_b activationResult == ER_Succeeded_b
